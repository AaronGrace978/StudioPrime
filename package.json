{
  "name": "studio-prime",
  "version": "1.0.0",
  "description": "Free screen & game capture with webcam overlay — built for creators. No license, no subscription, no paywall.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "icon": "python3 scripts/generate-icon.py"
  },
  "author": {
    "name": "Aaron Grace",
    "email": "aarongrace978@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/AaronGrace978/StudioPrime",
  "repository": {
    "type": "git",
    "url": "https://github.com/AaronGrace978/StudioPrime.git"
  },
  "bugs": {
    "url": "https://github.com/AaronGrace978/StudioPrime/issues"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.studioprime.app",
    "productName": "Studio Prime",
    "copyright": "Copyright © 2026 Aaron Grace",
    "artifactName": "StudioPrime-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Studio Prime",
      "artifactName": "StudioPrime-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "StudioPrime-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Video",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    }
  }
}
